# Copy this file to .env.local for local development.
# In Vercel, add the same variable(s) under Project Settings -> Environment Variables.

# Your Neon Postgres connection string. Use the "pooled" connection string
# shown in the Neon console (it works fine for this app's driver either way).
DATABASE_URL="postgresql://user:password@ep-xxxxxxxx.aws.neon.tech/neondb?sslmode=require"

# OpenRouteService API key (free tier is fine to start). Used for geocoding
# addresses and calculating delivery/pickup driving distances. Get one at
# https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=""

# Stripe secret key (starts with sk_test_... or sk_live_...) and webhook
# signing secret (starts with whsec_...). The webhook secret comes from
# the Stripe Dashboard once you've added an endpoint pointing at
# https://<your-domain>/api/stripe/webhook subscribed to at least
# payment_intent.succeeded and payment_intent.payment_failed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Publishable key (starts with pk_test_... or pk_live_...), safe to expose
# to the browser -- used by the booking page's Stripe Elements form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Gmail account used to send booking confirmation/cancellation emails via
# SMTP. Use a 16-character Google "App Password" (Google Account ->
# Security -> App passwords), not your regular Gmail password -- that
# requires 2-Step Verification to be enabled on the account.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Base URL used to build links inside emails (e.g. the Manage My Booking
# link). No trailing slash, e.g. https://yourdomain.com
NEXT_PUBLIC_BASE_URL=""
